# =====================================================================
# Afra Infra — Autonomous AI Merchant Environment Variables Example
# Copy this file to .env and fill in your credentials.
# NOTE: .env is gitignored and will never be committed.
# =====================================================================

# --- Google Gemini API (AI Buyer Agent) ---
# Used for natural language goal interpretation and automated catalog cart planning
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# --- Groq API (Independent AI Auditor) ---
# Used for secondary risk, fraud, and policy mismatch auditing
GROQ_API_KEY=your_groq_api_key_here
GROQ_AUDITOR_MODEL=llama-3.3-70b-versatile

# --- Razorpay Payment Gateway ---
# Mode: "mock" (default, in-memory simulation) or "live" (calls Razorpay API with test keys)
RAZORPAY_MODE=mock
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
